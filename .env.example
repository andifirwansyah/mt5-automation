# ============================================================
# Bootstrap / mandatory environment variables
# These values are loaded directly by AppSettings at startup.
# ============================================================

APP_NAME=AI Trading Automation
APP_ENV=development
APP_DEBUG=true

API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_trading

DASHBOARD_AUTH_SECRET=change-this-secret-to-a-long-random-value
AUTH_TOKEN_TTL_SECONDS=3600

MT5_LOGIN=12345678
MT5_PASSWORD=your-mt5-password
MT5_SERVER=YourBroker-Demo
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_TIMEOUT_MS=10000

# Execution safety switches
# Current code still reads these from .env (not runtime_configs DB yet).
AUTO_TRADE=true
APPROVAL_REQUIRED=false
DRY_RUN=true

# Trading bootstrap context
# Current code still reads these from .env.
ACCOUNT_MODE=DEMO_AUTO
TRADING_SYMBOL=XAUUSD
TRADING_TIMEFRAME=M5
CONTEXT_TIMEFRAMES=M15,M30,H1,H4
TRADING_MAGIC_NUMBER=20260527
ORDER_DEVIATION=20

# Runtime worker intervals
LISTENER_INTERVAL_SECONDS=1
POSITION_SYNC_INTERVAL_SECONDS=1
ACCOUNT_SNAPSHOT_INTERVAL_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=10
PERFORMANCE_INTERVAL_SECONDS=300

# Dynamic trade management
TRADE_MANAGEMENT_ENABLED=true
TRADE_MANAGEMENT_BREAKEVEN_TRIGGER_RATIO=0.60
TRADE_MANAGEMENT_BREAKEVEN_BUFFER_RATIO=0.05
TRADE_MANAGEMENT_TRAILING_ENABLED=true
TRADE_MANAGEMENT_TRAILING_ACTIVATION_RATIO=0.60
TRADE_MANAGEMENT_TRAILING_DISTANCE_RATIO=0.40
TRADE_MANAGEMENT_TRAILING_AGGRESSIVE_ACTIVATION_RATIO=0.80
TRADE_MANAGEMENT_TRAILING_AGGRESSIVE_DISTANCE_RATIO=0.10
TRADE_MANAGEMENT_MIN_STEP_RATIO=0.02

# Logging / timezone
LOG_LEVEL=INFO
LOG_ROTATION=10 MB
LOG_RETENTION=14 days
LOG_COMPRESSION=zip
TIMEZONE=UTC

# ============================================================
# Runtime-config DB fallback defaults
# These keys are seeded into trading.runtime_configs on startup.
# If DB override exists and is active, runtime uses DB value.
# ============================================================

MAX_SPREAD=50
MAX_OPEN_POSITIONS_PER_SYMBOL=3
MIN_EDGE_SAMPLE_SIZE=30
ALLOW_LOW_SAMPLE_EDGE=true
EDGE_MIN_WIN_RATE=0.45
EDGE_MIN_PROFIT_FACTOR=1.1
RISK_PER_TRADE_PERCENT=1.0
FIXED_LOT=0.01
MAX_LOT=1.0
MIN_RR=1.2
MAX_SPREAD_POINTS=50
MIN_MARGIN_LEVEL=100
MIN_FREE_MARGIN=0
PRETRADE_SPREAD_STRESS_MULTIPLIER=1.5
PRETRADE_SLIPPAGE_POINTS=5
MAX_DAILY_LOSS=500
MAX_TRADES_PER_DAY=20
MAX_CONSECUTIVE_LOSSES=5
MAX_OPEN_POSITIONS=10
AUTO_APPLY_STRATEGY_FEEDBACK=false
FEEDBACK_MIN_TRADES=20
FEEDBACK_LOW_WIN_RATE=0.4
FEEDBACK_HIGH_DRAWDOWN=500
MARKET_STRUCTURE_OVERRIDE_MIN_CONFIDENCE=0.70
MARKET_STRUCTURE_HARD_MIN_ROOM_ATR=0.30
MARKET_STRUCTURE_SOFT_MIN_ROOM_ATR=0.80
MARKET_STRUCTURE_ZONE_TOLERANCE_ATR=0.45
MARKET_STRUCTURE_DANGER_ZONE_ATR=0.55
MARKET_STRUCTURE_MIN_CANDLES_REQUIRED=30
SESSION_FILTER_ALLOWED_SESSIONS=ASIA,LONDON,NEW_YORK
SESSION_FILTER_BLOCK_ROLLOVER=true
SIGNAL_QUALITY_MIN_SCORE=0.45
TRADE_COOLDOWN_MINUTES=10


# WAHA
WAHA_BASE_URL=https://your-waha-host.example.com
WAHA_API_KEY=replace-with-your-waha-api-key
WAHA_DEFAULT_SESSION=default
WAHA_REQUEST_TIMEOUT_SECONDS=10

# GROQ AI
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_SECRET_KEY=replace-with-your-groq-secret-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_REQUEST_TIMEOUT_SECONDS=15
NOTIFICATION_AI_ENABLED=false
NOTIFICATION_AI_MAX_SENTENCES=3
NOTIFICATION_RETRY_ENABLED=true
NOTIFICATION_RETRY_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_BATCH_LIMIT=100
NOTIFICATION_RETRY_LOOP_INTERVAL_SECONDS=30
NOTIFICATION_RETRY_BACKOFF_BASE_SECONDS=60
NOTIFICATION_RETRY_BACKOFF_MULTIPLIER=2
NOTIFICATION_RETRY_BACKOFF_MAX_SECONDS=3600
