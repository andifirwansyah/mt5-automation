APP_ENV=development
APP_NAME=ai-trading-automation
LOG_LEVEL=INFO

DATASET_DIR=dataset
OUTPUT_DIR=outputs

# MySQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_trading_automation
DB_USERNAME=root
DB_PASSWORD=@Andi12345
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DATABASE_URL=mysql+pymysql://root:@Andi12345@127.0.0.1:3306/ai_trading_automation?charset=utf8mb4

# Storage backend runtime
TRADE_JOURNAL_BACKEND=db
PAPER_EXECUTION_BACKEND=db
STRICT_DB_RUNTIME=false

# Jangan aktifkan live trading sebelum semua safety gate siap.
TRADING_MODE=paper
ENABLE_LIVE_TRADING=false

# Risk defaults
MAX_RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
MAX_OPEN_POSITIONS=3
